						"type": "DatasetReference",
						"parameters": {
							"p_container": "@activity('Lookup_Get_Job_Metadata').output.value[0].target_container",
							"p_folder_path": "@concat(     activity('Lookup_Get_Job_Metadata').output.value[0].target_path,     '/',     formatDateTime(utcnow(),'yyyy/MM/dd') )",
							"p_file_name": {
								"value": "@concat(\n    last(\n        split(\n            activity('Lookup_Get_Job_Metadata').output.value[0].api_endpoint,\n            '/'\n        )\n    ),\n    '_',\n    formatDateTime(utcnow(),'ddMMyyyy'),\n    '.parquet'\n)",
