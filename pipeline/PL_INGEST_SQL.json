							"type": "String"
						},
						"job_id": {
							"value": {
								"value": "@pipeline().parameters.p_job_id",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"job_status": {
							"value": "'FAILED'",
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"records_read": {
							"value": "'NULL'",
							"type": "String"
						},
						"records_written": {
							"value": "'NULL'",
							"type": "String"
						},
						"source_file": {
							"value": {
								"value": "@activity('Lookup_SQL_Job_Metadata').output.firstRow.source_table",
								"type": "Expression"
							},
							"type": "String"
						},
						"target_path": {
							"value": {
								"value": "@activity('Lookup_SQL_Job_Metadata').output.firstRow.target_path",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AZSQL_CONTROL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Update_Watermark",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_SQL_To_Landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[vb_update_watermark]",
					"storedProcedureParameters": {
						"job_id": {
							"value": {
								"value": "@pipeline().parameters.p_job_id",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"last_watermark_value": {
							"value": {
								"value": "@activity('Lookup_Current_Watermark').output.firstRow.current_waterma",
