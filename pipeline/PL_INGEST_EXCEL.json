{
	"name": "PL_INGEST_EXCEL",
	"properties": {
		"activities": [
			{
				"name": "Copy_EXCEL_To_Landing",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": {
								"value": "@pipeline().parameters.p_source_path",
								"type": "Expression"
							},
							"wildcardFileName": {
								"value": "@pipeline().parameters.p_file_pattern",
								"type": "Expression"
							},
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_EXCEL_SOURCE",
						"type": "DatasetReference",
						"parameters": {
							"p_container": "@activity('Lookup_Get_Job_Metadata').output.value[0].source_container",
							"p_folder_path": "@activity('Lookup_Get_Job_Metadata').output.value[0].source_path",
							"p_file_name": "@activity('Lookup_Get_Job_Metadata').output.value[0].file_pattern",
							"p_sheet_name": "@activity('Lookup_Get_Job_Metadata').output.value[0].sheet_name"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_PARQUET_SINK",
						"type": "DatasetReference",
						"parameters": {
							"p_container": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].target_container",
								"type": "Expression"
							},
							"p_folder_path": {
								"value": "@concat(\n    activity('Lookup_Get_Job_Metadata').output.value[0].target_path,\n    '/',\n    formatDateTime(utcnow(),'yyyy/MM/dd')\n)",
								"type": "Expression"
							},
							"p_file_name": {
								"value": "@concat(\n    split(\n        activity('Lookup_Get_Job_Metadata').output.value[0].file_pattern,\n        '_*'\n    )[0],\n    '_',\n    formatDateTime(utcnow(),'ddMMyyyy'),\n    '.parquet'\n)",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SP_End_Log_Failure_Excel",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_EXCEL_To_Landing",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[vb_end_log_entry]",
					"storedProcedureParameters": {
						"error": {
							"value": {
								"value": "@activity('Copy_EXCEL_To_Landing').error.message",
								"type": "Expression"
							},
							"type": "String"
						},
						"job_id": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].job_id",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"job_status": {
							"value": "'FAILED'",
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"records_read": {
							"value": "'NULL'",
							"type": "String"
						},
						"records_written": {
							"value": "'NULL'",
							"type": "String"
						},
						"source_file": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].file_pattern",
								"type": "Expression"
							},
							"type": "String"
						},
						"target_path": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].target_path",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AZSQL_CONTROL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_End_Log_Success_Excel",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_EXCEL_To_Landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[vb_end_log_entry]",
					"storedProcedureParameters": {
						"error": {
							"value": "'NULL'",
							"type": "String"
						},
						"job_id": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].job_id",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"job_status": {
							"value": "'SUCCESS'",
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"records_read": {
							"value": {
								"value": "@activity('Copy_EXCEL_To_Landing').output.rowsRead",
								"type": "Expression"
							},
							"type": "String"
						},
						"records_written": {
							"value": {
								"value": "@activity('Copy_EXCEL_To_Landing').output.rowsCopied",
								"type": "Expression"
							},
							"type": "String"
						},
						"source_file": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].file_pattern",
								"type": "Expression"
							},
							"type": "String"
						},
						"target_path": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].target_path",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AZSQL_CONTROL",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"p_job_id": {
				"type": "string"
			},
			"p_source_container": {
				"type": "string"
			},
			"p_source_path": {
				"type": "string"
			},
			"p_file_pattern": {
				"type": "string"
			},
			"p_sheet_name": {
				"type": "string"
			},
			"p_target_container": {
				"type": "string"
			},
			"p_target_path": {
				"type": "string"
			},
			"p_pipeline_run_id": {
				"type": "string"
			}
		},
		"annotations": []
	}
}