{
	"name": "PL_INGEST_JSON",
	"properties": {
		"activities": [
			{
				"name": "Copy_JSON_To_Landing",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": {
								"value": "@pipeline().parameters.p_source_path",
								"type": "Expression"
							},
							"wildcardFileName": {
								"value": "@pipeline().parameters.p_file_pattern",
								"type": "Expression"
							},
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "['customer_id']"
								},
								"sink": {
									"name": "customer_id"
								}
							},
							{
								"source": {
									"path": "['customer_name']"
								},
								"sink": {
									"name": "customer_name"
								}
							},
							{
								"source": {
									"path": "['email']"
								},
								"sink": {
									"name": "email"
								}
							},
							{
								"source": {
									"path": "['phone']"
								},
								"sink": {
									"name": "phone"
								}
							},
							{
								"source": {
									"path": "['registration_date']"
								},
								"sink": {
									"name": "registration_date"
								}
							},
							{
								"source": {
									"path": "['active_flag']"
								},
								"sink": {
									"name": "active_flag"
								}
							},
							{
								"source": {
									"path": "['address']['city']"
								},
								"sink": {
									"name": "city"
								}
							},
							{
								"source": {
									"path": "['address']['state']"
								},
								"sink": {
									"name": "state"
								}
							},
							{
								"source": {
									"path": "['address']['country']"
								},
								"sink": {
									"name": "country"
								}
							},
							{
								"source": {
									"path": "['address']['postal_code']"
								},
								"sink": {
									"name": "postal_code"
								}
							},
							{
								"source": {
									"path": "['preferences']['language']"
								},
								"sink": {
									"name": "language"
								}
							},
							{
								"source": {
									"path": "['preferences']['notification']"
								},
								"sink": {
									"name": "notification"
								}
							},
							{
								"source": {
									"path": "['orders'][0]['order_id']"
								},
								"sink": {
									"name": "order_id"
								}
							},
							{
								"source": {
									"path": "['orders'][0]['amount']"
								},
								"sink": {
									"name": "amount"
								}
							},
							{
								"source": {
									"path": "['orders'][0]['status']"
								},
								"sink": {
									"name": "status"
								}
							}
						],
						"collectionReference": "$"
					}
				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_JSON_SOURCE",
						"type": "DatasetReference",
						"parameters": {
							"p_container": {
								"value": "@pipeline().parameters.p_source_container",
								"type": "Expression"
							},
							"p_folder_path": {
								"value": "@pipeline().parameters.p_source_path",
								"type": "Expression"
							},
							"p_file_name": {
								"value": "@pipeline().parameters.p_file_pattern",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_PARQUET_SINK",
						"type": "DatasetReference",
						"parameters": {
							"p_container": {
								"value": "@pipeline().parameters.p_target_container",
								"type": "Expression"
							},
							"p_folder_path": {
								"value": "@concat(pipeline().parameters.p_target_path,'/',formatDateTime(utcnow(),'yyyy/MM/dd'))",
								"type": "Expression"
							},
							"p_file_name": {
								"value": "@concat(split(pipeline().parameters.p_file_pattern,'_*')[0],'_',formatDateTime(utcnow(),'ddMMyyyy'),'.parquet')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "SP_End_Log_Failure_Json_copy",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_JSON_To_Landing",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[vb_end_log_entry]",
					"storedProcedureParameters": {
						"error": {
							"value": {
								"value": "@activity('Copy_JSON_To_Landing').error.message",
								"type": "Expression"
							},
							"type": "String"
						},
						"job_id": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].job_id",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"job_status": {
							"value": "'FAILED'",
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"records_read": {
							"value": "'NULL'",
							"type": "String"
						},
						"records_written": {
							"value": "'NULL'",
							"type": "String"
						},
						"source_file": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].file_pattern",
								"type": "Expression"
							},
							"type": "String"
						},
						"target_path": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].target_path",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AZSQL_CONTROL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_End_Log_Success_Json_copy",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_JSON_To_Landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[vb_end_log_entry]",
					"storedProcedureParameters": {
						"error": {
							"value": "'NULL'",
							"type": "String"
						},
						"job_id": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].job_id",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"job_status": {
							"value": "'SUCCESS'",
							"type": "String"
						},
						"pipeline_run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"records_read": {
							"value": {
								"value": "@activity('Copy_JSON_To_Landing').output.rowsRead",
								"type": "Expression"
							},
							"type": "String"
						},
						"records_written": {
							"value": {
								"value": "@activity('Copy_JSON_To_Landing').output.rowsCopied",
								"type": "Expression"
							},
							"type": "String"
						},
						"source_file": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].file_pattern",
								"type": "Expression"
							},
							"type": "String"
						},
						"target_path": {
							"value": {
								"value": "@activity('Lookup_Get_Job_Metadata').output.value[0].target_path",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AZSQL_CONTROL",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"p_job_id": {
				"type": "string"
			},
			"p_source_container": {
				"type": "string"
			},
			"p_source_path": {
				"type": "string"
			},
			"p_file_pattern": {
				"type": "string"
			},
			"p_target_container": {
				"type": "string"
			},
			"p_target_path": {
				"type": "string"
			},
			"p_pipeline_run_id": {
				"type": "string"
			}
		},
		"annotations": []
	}
}