					"LS_SQLSERVER_ECOMMERCE_ONPREM_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLSERVER_ECOMMERCE_ONPREM_properties_typeProperties_server')]"
					},
					"LS_SQLSERVER_ECOMMERCE_ONPREM_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLSERVER_ECOMMERCE_ONPREM_properties_typeProperties_database')]"
