		},
		"LS_ADLS_SNOWFLAKE_STAGE_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_ADLS_SNOWFLAKE_STAGE'"
		},
		"LS_AZSQL_CONTROL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AZSQL_CONTROL'"
